      "excludeSource": ["Controller", "Services"],
      "excludeTest": ["ApplicationTest", "DefaultTest"],
      "javaFeatures": ["graalvm", "awaitility"],
      "kotlinFeatures": ["graalvm", "awaitility"]
    },
    {
      "name": "chess-listener",
      "features": ["kafka", "data-jdbc", "flyway", "oracle-cloud-atp", "reactor", "testcontainers", "testcontainers-kafka"],
      "invisibleFeatures": ["test-resources-jdbc-oracle-free"],
      "pythonFeatures": ["serialization-jackson", "test-resources", "validation"],
      "excludeSource": ["Controller", "Services"],
      "excludeTest": ["ApplicationTest", "DefaultTest"],
      "javaFeatures": ["graalvm", "awaitility"],
      "kotlinFeatures": ["graalvm", "awaitility"]
    }
  ]
}
