{
  "title": "Oracle Cloud Streaming and the Micronaut Framework - Event-Driven Applications at Scale",
  "intro": "Use Oracle Cloud Streaming to communicate between your Micronaut applications.",
  "authors": ["Burt Beckwith"],
  "tags": [],
  "categories": ["Messaging"],
  "cloud": "OCI",
  "publicationDate": "2021-07-30",
  "zipIncludes": ["docker/docker-compose.yml"],
  "python": true,
  "apps": [
    {
      "name": "chess-game",
      "features": ["kafka", "reactor", "testcontainers", "testcontainers-kafka", "validation"],
