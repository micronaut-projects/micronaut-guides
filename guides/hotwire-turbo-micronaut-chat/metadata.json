{
  "title": "Hotwire Turbo Chat with Micronaut Views",
  "intro": "This guide shows how to build a Micronaut Framework chat application such as the Rails application demonstrated in the Hotwire announcement screencast.",
  "authors": ["Sergio del Amo"],
  "tags": ["hotwire", "turbo","websocket"],
  "categories": ["Turbo"],
  "publicationDate": "2022-06-20",
  "languages": ["JAVA"],
  "python": true,
  "apps": [
    {
      "name": "initial",
      "features": ["websocket", "views-thymeleaf", "data-jdbc", "flyway", "jdbc-hikari", "mysql", "serialization-jackson", "validation", "turbo"],
      "excludeSource": ["Controller", "Services"],
      "javaFeatures": ["graalvm", "junit-params"],
      "kotlinFeatures": ["graalvm", "junit-params"]
    },
    {
      "name": "complete",
      "features": ["websocket", "views-thymeleaf", "data-jdbc", "flyway", "jdbc-hikari", "mysql", "reactor", "serialization-jackson", "validation", "turbo"],
      "excludeSource": ["Controller", "Services"],
      "kotlinFeatures": ["graalvm", "junit-params"],
      "javaFeatures": ["graalvm", "awaitility", "junit-params"]
    }
  ]
}
